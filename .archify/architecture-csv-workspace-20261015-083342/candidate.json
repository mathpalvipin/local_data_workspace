  "cards": [
    { "dot": "cyan", "title": "Worker replies (not drawn)", "items": [
      "progress / loaded / error → WorkerProvider state (status, rowCount, columns, bytes, loadMs)",
      "page {start, rows} → usePageCache: 200-row pages, max 20 kept (LRU, ~4k rows on main thread)",
      "filtered {matched, ms} → useFilter; bumps seq, which remounts the Grid with a fresh cache",
      "All listeners use addEventListener so the three consumers never cut each other off"
    ] },
    { "dot": "rose", "title": "Ownership boundary", "items": [
      "Rows never cross postMessage except as page-sized string slices",
      "WorkerProvider sits above BrowserRouter so navigation never terminates the worker",
      "A refresh or cold /preview deep-link starts an empty worker → redirect to /",
      "No persistence: OPFS / IndexedDB caching deliberately deferred"
    ] },
    { "dot": "emerald", "title": "Columnar store", "items": [
      "Kinds: int32, float32, date (integer days), dict (<256 distinct), blob",
      "Chunk callback push()es every row; finalize() compacts; bytes() feeds the memory report",
      "filter() writes a Uint32Array of matching row indices; page() maps through it",
      "gt / lt compare numerically only for int32/float32, as text otherwise (ISO dates)"
    ] },
    { "dot": "amber", "title": "Failure handling", "items": [
      "Sync errors caught in onmessage → error reply",
      "Async PapaParse chunk/read errors go through fail(), which clears the store and suppresses 'loaded'"
    ] },
    { "dot": "violet", "title": "Secondary & dev-only", "items": [
      "/bench (BenchPage): naive vs columnar parse on the main thread for comparison",
      "csvReader.ts: vanilla main-thread baseline, exercised only by tests",
      "FrameCounter: rAF responsiveness probe on Load and Bench pages",
      "scripts/csvgenerate.mjs (npm run generate) writes test data"
    ] },
    { "dot": "slate", "title": "External dependencies", "items": [
      "papaparse ^5.7 (streaming CSV parser, runs inside the worker)",
      "react 19 + react-router-dom 7 (UI and routing)",
      "Vite ?worker import bundles csv.worker as a module worker",
      "Browser File API supplies the local file; nothing leaves the machine"
    ] }
  ]
